# /etc/systemd/system/portal.service
[Unit]
Description=University Result Portal (Flask + gunicorn)
After=network.target

[Service]
User=portal
Group=portal
WorkingDirectory=/opt/portal/app
ExecStart=/opt/portal/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
